# Match both Rust formatters on every platform.
*.rs text eol=lf
# Keep JavaScript formatting stable across Windows and POSIX checkouts.
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
# Keep the embedded recipient download identical across platform checkouts.
crates/ruphish-ui/assets/recipient-template.csv text eol=lf
# Preserve the exact bytes used by fixture manifests and copied SQL provenance.
tests/fixtures/** -text
# Keep release migration checksums identical across platform checkouts.
crates/ruphish-adapters/migrations/** text eol=lf
# Container entrypoints must retain POSIX line endings on Windows checkouts.
tests/acceptance/*.sh text eol=lf
docker/*.sh text eol=lf
