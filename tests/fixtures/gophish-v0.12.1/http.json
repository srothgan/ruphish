  {
    "id": "group-create",
    "boundary": "api-router",
    "method": "POST",
    "path": "/api/groups/",
    "headers": {
      "Authorization": "Bearer 1111111111111111111111111111111111111111111111111111111111111111",
      "Content-Type": "application/json"
    },
    "body": "{\"name\":\"Fixture group\",\"targets\":[{\"email\":\"ada@example.test\",\"first_name\":\"Ada\",\"last_name\":\"Example\",\"position\":\"Engineer\"}]}",
    "expected_status": 201,
    "expected_headers": {
      "Access-Control-Allow-Origin": "*",
      "Content-Type": "application/json"
    },
    "expected_json": {
      "id": 1,
      "modified_date": "\u003cgenerated-time\u003e",
      "name": "Fixture group",
      "targets": [
        {
          "email": "ada@example.test",
          "first_name": "Ada",
          "last_name": "Example",
          "position": "Engineer"
        }
      ]
    },
    "normalized_json_pointers": [
      "/modified_date"
    ]
  },
