---
import Site from '../layouts/Site.astro';
---
<Site title="Page not found | Ruphish" description="The page you were looking for does not exist.">
  <section class="not-found shell" aria-labelledby="not-found-title">
    <p class="post-meta">404</p>
    <h1 id="not-found-title">Page not found.</h1>
    <p class="lead">The page may have moved, or the link may be out of date.</p>
    <div class="actions"><a class="button primary" href="/">Back to home</a><a class="button secondary" href="/docs/">Documentation</a></div>
  </section>
</Site>
