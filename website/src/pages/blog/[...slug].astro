---
import { render } from 'astro:content';
import Site from '../../layouts/Site.astro';
import TagList from '../../components/TagList.astro';
import { publishedPosts, formatDate } from '../../blog';
import { socialImage } from '../../site';

export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, author, tags } = post.data;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  author: { '@type': 'Person', name: author },
  image: Astro.site ? new URL(socialImage, Astro.site).href : undefined,
  mainEntityOfPage: Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined,
};
---
<Site title={`${title} | Ruphish blog`} description={description}>
  <article class="blog shell">
    <header>
      <p class="back-link"><a href="/blog/">← Back to blog</a></p>
      <h1>{title}</h1>
      <p class="post-meta"><time datetime={date.toISOString()}>{formatDate(date)}</time> · {author}</p>
      <TagList tags={tags} />
    </header>
    <div class="prose"><Content /></div>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
</Site>
