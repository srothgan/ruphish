---
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import ExternalLinkIcon from './ExternalLinkIcon.astro';
import { demo } from '../site';
---
<a class="site-link external-link" href={demo}>Demo <ExternalLinkIcon /></a>
<a class="site-link" href="/blog/">Blog</a>
<a class="site-link" href="/about/">About</a>
<SocialIcons><slot /></SocialIcons>
<style>
  .site-link { color: var(--sl-color-text); font-size: var(--sl-text-sm); text-decoration: none; }
  .site-link:hover { text-decoration: underline; }
  .external-link { display: inline-flex; align-items: center; gap: 4px; }
</style>
