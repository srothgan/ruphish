---
import '../styles/fonts.css';
import '../styles/site.css';
import wordmark from '../assets/ruphish-wordmark-white.svg';
import ProjectFooter from '../components/ProjectFooter.astro';
import ExternalLinkIcon from '../components/ExternalLinkIcon.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import { repository, demo, socialImage, description as defaultDescription } from '../site';
interface Props { title: string; description?: string; }
const { title, description = defaultDescription } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const ogImage = Astro.site ? new URL(socialImage, Astro.site) : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c2f2b" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ruphish" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:alt" content="Ruphish" />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Analytics />
    <SpeedInsights />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a href="/" class="brand" aria-label="Ruphish home"><img src={wordmark.src} alt="Ruphish" width="137" height="45" /></a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" hidden>
          Menu
          <svg viewBox="0 0 24 24" aria-hidden="true"><path class="menu-icon" d="M4 6h16M4 12h16M4 18h16" /><path class="close-icon" d="m6 6 12 12M6 18 18 6" /></svg>
        </button>
        <nav id="site-nav" aria-label="Main navigation">
          <a href="/docs/">Docs</a>
          <a href={demo} class="external-link">Demo <ExternalLinkIcon /></a>
          <a href="/blog/" aria-current={Astro.url.pathname.startsWith('/blog/') ? 'page' : undefined}>Blog</a>
          <a href="/about/" aria-current={Astro.url.pathname === '/about/' ? 'page' : undefined}>About</a>
          <a href={repository} class="external-link">GitHub <ExternalLinkIcon /></a>
        </nav>
      </div>
    </header>
    <script>
      import { setupNavigation } from '../navigation.mjs';
      const header = document.querySelector<HTMLElement>('.site-header');
      if (header) setupNavigation(header, window.matchMedia('(max-width: 700px)'));
    </script>
    <main id="main"><slot /></main>
    <ProjectFooter />
  </body>
</html>
