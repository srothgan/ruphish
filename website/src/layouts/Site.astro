---
import '../styles/fonts.css';
import '../styles/site.css';
import wordmark from '../assets/ruphish-wordmark-white.svg';
import ProjectFooter from '../components/ProjectFooter.astro';
import { repository, description as defaultDescription } from '../site';
interface Props { title: string; description?: string; }
const { title, description = defaultDescription } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c2f2b" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a href="/" class="brand" aria-label="Ruphish home"><img src={wordmark.src} alt="Ruphish" width="137" height="45" /></a>
        <nav aria-label="Main navigation">
          <a href="/docs/">Docs</a>
          <a href="/about/" aria-current={Astro.url.pathname === '/about/' ? 'page' : undefined}>About</a>
          <a href={repository} class="source-link">GitHub <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg></a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <ProjectFooter />
  </body>
</html>
